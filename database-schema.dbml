// MUHUZE Global Link — Database Schema DBML for dbdiagram.io
// Paste this at: https://dbdiagram.io/d -> clear the editor -> paste all
// Source of truth: backend/app/modules/*/models.py (SQLAlchemy models),
// registered centrally in backend/app/db/models.py.
// CONVENTION: every FK is declared inline on its column with [ref: X], and a
// table is added only once we can answer: what does it represent, who owns
// it, what it references, its cardinality, and what constrains the relation.
// Operators: `>` many-to-one, `-` one-to-one, `<` one-to-many.
// Only the built modules are listed; wallets/withdrawals/referrals/
// seller_verification/notifications/admin are planned, not yet built.
// UUID matches the real Postgres schema.
//
// COMMERCE (orders/payments/revenue/shipping_addresses/carts) is designed
// here ahead of its SQLAlchemy implementation. Frontend never computes
// money — every money fact has exactly one backend record (see
// backend/docs/financial-flow-design.md): order -> payment -> revenue.
// A cart references seller_listings (a specific seller's offer). The order
// belongs to the BUYER and is multi-seller capable: each order_item carries
// seller_id, so the backend always knows who fulfills what even inside one
// order. shipping_infos is an immutable per-order SNAPSHOT of the chosen
// shipping_address — later edits to the address book never change past
// orders. seller_orders (per-seller fulfillment, created at payment time) +
// shipments (delivery tracking) are now active: orders -> seller_orders
// (one per distinct seller) -> shipments.
// State machines are separate (order / payment_status / seller fulfillment).

// ── Catalog: categories ──────────────────────────────────────────────
Table categories {
  id uuid [pk]
  parent_id uuid [ref: > categories.id, note: 'self-referential parent — null = top level; unique (parent_id, name)']
  name varchar(150) [not null]
  slug varchar(170) [not null, unique]
  description text
  image varchar(255) [note: 'Cloudinary URL']
  sort_order int [not null, default: 0]
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Catalog: sellers (supplier bridge) ───────────────────────────────
Table sellers {
  id uuid [pk]
  account_id uuid [not null, unique, ref: - accounts.id, note: '1:0..1 with accounts']
  business_name varchar(150) [not null, unique]
  business_description text
  status varchar(20) [not null, default: 'draft', note: 'draft | pending_review | active | rejected | suspended | deactivated']
  rejection_reason text
  submitted_at timestamp [note: 'null if draft']
  reviewed_by uuid [note: 'accounts.id of the admin who reviewed']
  reviewed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table seller_documents {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id, note: 'CASCADE delete; unique (seller_id, document_type)']
  document_type varchar(30) [not null, note: 'national_id_front | national_id_back | passport | driving_license']
  cloudinary_public_id varchar(255) [not null]
  cloudinary_resource_type varchar(20) [not null]
  original_filename varchar(255)
  mime_type varchar(100) [not null]
  file_size int [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Subscriptions: premium plans & seller subscriptions ──────────────
// The commission MUHUZE keeps on a sale depends on whether the seller is
// subscribed: a BASIC (unsubscribed) seller pays 12%, a PREMIUM
// (subscribed) seller pays the plan's `commission_rate` (7%). Each plan
// also spells out its pricing, duration, and every benefit it unlocks so
// the ERD is self-documenting (no opaque credits/JSON blob).
Table premium_plans {
  id uuid [pk]
  code varchar(40) [not null, unique, note: 'premium-monthly | premium-annual']
  name varchar(50) [not null, note: 'Monthly | Annual']
  description varchar(255) [note: 'seller-facing blurb shown on the plan card']
  price decimal(12,2) [not null, note: '10 (monthly) / 100 (annual)']
  currency varchar(8) [not null, default: 'USD', note: 'billing currency (USD)']
  duration_days int [not null, note: '30 (monthly) / 365 (annual)']
  // ── the rates ─────────────────────────────────────────────────────
  commission_rate decimal(5,2) [not null, note: 'seller pays this %% of every sale while subscribed (7) — vs 12%% when not subscribed']
  listing_limit int [not null, default: 0, note: 'max active listings (0 = unlimited for premium)']
  // ── benefits the plan unlocks (each is a named boolean, not a blob) ─
  premium_badge boolean [not null, default: false, note: 'shows the premium badge on the shop']
  unlimited_listings boolean [not null, default: false, note: 'no listing cap while active']
  priority_notifications boolean [not null, default: false]
  early_promotion_access boolean [not null, default: false]
  premium_only_promotions boolean [not null, default: false]
  premium_discounts boolean [not null, default: false]
  enhanced_favorites boolean [not null, default: false]
  priority_support boolean [not null, default: false]
  priority_service_handling boolean [not null, default: false]
  referral_commission_eligible boolean [not null, default: false, note: 'may earn referral commission']
  enhanced_visibility boolean [not null, default: false, note: 'boosted marketplace placement']
  promotional_advantages boolean [not null, default: false]
  advanced_analytics boolean [not null, default: false]
  seller_verification_eligible boolean [not null, default: false, note: 'can request MUHUZE seller verification']
  is_active boolean [not null, default: true, note: 'whether this plan can be purchased']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table seller_subscriptions {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id, note: 'a seller can hold many rows (purchase history); exactly one should be active at a time']
  plan_id uuid [not null, ref: > premium_plans.id, note: 'which plan was bought']
  status varchar(20) [not null, default: 'active', note: 'active | expired | cancelled']
  commission_rate decimal(5,2) [not null, note: 'snapshot of the plan commission_rate at purchase time — so the rate applied stays auditable even if the plan later changes']
  starts_at timestamp [not null]
  expires_at timestamp [not null, note: 'starts_at + plan.duration_days; status flips to expired in the past']
  cancelled_at timestamp [note: 'set when manually cancelled before expiry']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Catalog: brands & attributes ─────────────────────────────────────
Table brands {
  id uuid [pk]
  name varchar(150) [not null, unique]
  slug varchar(170) [not null, unique]
  description text
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table attributes {
  id uuid [pk]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  input_type varchar(20) [not null, default: 'select', note: 'select | text | number | boolean']
  unit varchar(20)
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table category_attributes {
  id uuid [pk]
  category_id uuid [not null, ref: > categories.id]
  attribute_id uuid [not null, ref: > attributes.id, note: 'unique (category_id, attribute_id)']
  is_required boolean [not null, default: false]
  is_variant boolean [not null, default: false]
  is_filterable boolean [not null, default: false]
  sort_order int [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Catalog: products (SPU) ──────────────────────────────────────────
Table products {
  id uuid [pk]
  category_id uuid [not null, ref: > categories.id]
  brand_id uuid [ref: > brands.id, note: 'null = no brand']
  created_by_seller_id uuid [ref: > sellers.id, note: 'null = admin-curated directly; else the requesting seller']
  name varchar(255) [not null]
  slug varchar(280) [not null, unique]
  description text [note: 'may contain markdown']
  status varchar(20) [not null, default: 'draft', note: 'draft | pending_review | active | rejected | archived']
  rejection_reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table product_variants {
  id uuid [pk]
  product_id uuid [not null, ref: > products.id, note: 'CASCADE delete']
  sku_code varchar(50)
  status varchar(20) [not null, default: 'active', note: 'active | inactive']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table variant_attribute_values {
  id uuid [pk]
  variant_id uuid [not null, ref: > product_variants.id, note: 'CASCADE delete; unique (variant_id, attribute_id)']
  attribute_id uuid [not null, ref: > attributes.id]
  value varchar(255) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table product_images {
  id uuid [pk]
  product_id uuid [not null, ref: > products.id, note: 'CASCADE delete']
  cloudinary_public_id varchar(255) [not null]
  cloudinary_resource_type varchar(20) [not null]
  original_filename varchar(255)
  mime_type varchar(100) [not null]
  file_size int [not null]
  sort_order int [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Catalog: seller listings (the offer) ─────────────────────────────
Table seller_listings {
  id uuid [pk]
  seller_id uuid [not null, ref: > sellers.id, note: 'unique (seller_id, variant_id)']
  variant_id uuid [not null, ref: > product_variants.id]
  price decimal(12,2) [not null]
  stock int [not null, default: 0]
  seller_sku varchar(100)
  condition varchar(20) [not null, default: 'new', note: 'new | like_new | used']
  status varchar(20) [not null, default: 'draft', note: 'draft | pending_review | active | rejected | suspended | out_of_stock | archived']
  rejection_reason text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table listing_images {
  id uuid [pk]
  listing_id uuid [not null, ref: > seller_listings.id, note: 'CASCADE delete']
  cloudinary_public_id varchar(255) [not null]
  cloudinary_resource_type varchar(20) [not null]
  original_filename varchar(255)
  mime_type varchar(100) [not null]
  file_size int [not null]
  sort_order int [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Commerce: carts & addresses ─────────────────────────────────────
Table cart_items {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id, note: 'the buyer']
  listing_id uuid [not null, ref: > seller_listings.id, note: 'a specific seller offer; unique (account_id, listing_id) — adding again bumps quantity']
  quantity int [not null, default: 1, note: '>= 1']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// The customer's address BOOK — mutable and editable. Orders never depend
// on a live row here; they reference an immutable snapshot (shipping_infos).
Table shipping_addresses {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id, note: 'owner']
  label varchar(50) [note: 'Home | Work | Other']
  recipient_name varchar(150) [not null]
  phone varchar(20) [not null, note: 'delivery recipient phone — separate from accounts.phone (deliver to mother, call her)']
  country varchar(60) [not null, default: 'Rwanda']
  province varchar(100)
  district varchar(100)
  sector varchar(100)
  cell varchar(100)
  village varchar(100)
  address_line varchar(255) [note: 'street / building / landmarks']
  delivery_instructions varchar(255) [note: 'e.g. call on arrival, deliver after 6pm']
  latitude decimal(10,7) [note: 'for future delivery calc + nearby sellers']
  longitude decimal(10,7)
  is_default boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Commerce: orders (buyer-owned, multi-seller capable) ─────────────
// The order belongs to the BUYER, not any seller. One checkout can span
// many sellers: each order_item carries its own seller_id, so the backend
// always knows who must fulfill what — even though it's a single order from
// the customer's perspective. ALL money here is GROSS (what the buyer
// pays), captured as snapshots at checkout. The commission split is derived
// later in revenue_transactions, never stored redundantly here.
// State machines are intentionally SEPARATE:
//   order lifecycle: pending | cancelled
//   payment_status:  pending | paid | failed | refunded | partially_refunded
//   seller fulfillment (seller_orders): pending | accepted | shipped
//                      | delivered | rejected | cancelled
Table orders {
  id uuid [pk]
  order_number varchar(30) [not null, unique, note: 'human-readable, e.g. MUH-2026-000123']
  buyer_account_id uuid [not null, ref: > accounts.id, note: 'belongs to the buyer, never a seller']
  status varchar(20) [not null, default: 'pending', note: 'order lifecycle: pending | cancelled']
  payment_status varchar(20) [not null, default: 'pending', note: 'pending | paid | failed | refunded | partially_refunded — sourced from payments']
  shipping_address_id uuid [ref: > shipping_addresses.id, note: 'which saved address was picked at checkout (for reference)']
  shipping_info_id uuid [ref: > shipping_infos.id, note: 'the immutable order-owned snapshot actually used for delivery']
  contact_phone varchar(20) [note: 'captured at checkout — separate from accounts.phone']
  subtotal decimal(12,2) [not null, default: '0', note: 'sum of order_items subtotal']
  shipping_fee decimal(12,2) [not null, default: '0', note: 'total delivery fee across sellers']
  discount_amount decimal(12,2) [not null, default: '0', note: 'promo discount (0 for now)']
  total_amount decimal(12,2) [not null, note: 'subtotal + shipping_fee - discount_amount']
  currency varchar(8) [not null, default: 'RWF']
  notes varchar(255) [note: 'buyer order notes']
  paid_at timestamp
  completed_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id]
  seller_id uuid [not null, ref: > sellers.id, note: 'which seller fulfills/earns this line — the multi-seller key']
  listing_id uuid [not null, ref: > seller_listings.id, note: 'the exact seller offer bought']
  product_variant_id uuid [not null, ref: > product_variants.id]
  product_name varchar(255) [not null, note: 'transaction snapshot — never a live join (see below)']
  variant_name varchar(255) [note: 'e.g. 128GB / Black']
  unit_price decimal(12,2) [not null, note: 'SNAPSHOT from the listing at purchase time']
  quantity int [not null]
  subtotal decimal(12,2) [not null, note: 'unit_price * quantity']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// WHY the snapshot matters: seller A sells a phone today for 150000 and
// raises it to 170000 tomorrow. The completed order must still say 150000 —
// so order_items copies product_name/variant_name/unit_price at purchase
// instead of trusting the live product/listing rows. This is the single
// most important ecommerce-schema concept and is built in from the start.

Table shipping_infos {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id, note: 'one immutable snapshot per order']
  recipient_name varchar(150) [not null]
  phone varchar(20) [not null]
  country varchar(60) [not null, default: 'Rwanda']
  province varchar(100)
  district varchar(100)
  sector varchar(100)
  cell varchar(100)
  village varchar(100)
  address_line varchar(255)
  delivery_instructions varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Commerce: seller fulfillment & delivery ─────────────────────────
// seller_orders groups the order by seller (one row per distinct seller),
// created in the same DB transaction as revenue when Payment -> paid.
// Shipments hang off seller_orders and track carrier/delivery status.
Table seller_orders {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id, note: 'which buyer order this fulfills']
  seller_id uuid [not null, ref: > sellers.id, note: 'which seller fulfills this group']
  status varchar(20) [not null, default: 'pending', note: 'pending | accepted | rejected | shipped | delivered | cancelled']
  rejected_reason text [note: 'set when seller rejects']
  accepted_at timestamp [note: 'set on accept']
  shipped_at timestamp [note: 'set on ship']
  delivered_at timestamp [note: 'set on deliver']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (order_id) [note: 'fast lookup by buyer order']
    (seller_id) [note: 'fast lookup by seller']
    (status) [note: 'filter by fulfillment status']
    unique(order_id, seller_id) [name: 'uq_seller_orders_order_seller']
  }
}

Table shipments {
  id uuid [pk]
  seller_order_id uuid [not null, ref: > seller_orders.id, note: 'which seller order this shipment belongs to']
  carrier varchar(60) [note: 'carrier name (nullable until assigned)']
  tracking_number varchar(255) [note: 'carrier tracking ref']
  status varchar(20) [not null, default: 'pending', note: 'pending | shipped | delivered']
  shipped_at timestamp [note: 'when carrier picked up']
  delivered_at timestamp [note: 'when delivered to buyer']
  notes text
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (seller_order_id) [note: 'fast lookup by seller order']
    (status) [note: 'filter by shipment status']
  }
}

// ── Commerce: payments & revenue ────────────────────────────────────
// Payment stays its own module so money-in isn't tangled into orders.
// Mobile money (Airtel Money) is the first payment method: create ->
// request_reference (stored as provider_ref) -> callback POST /{id}/paid
// -> revenue + seller_orders derived in the same DB transaction.
Table payments {
  id uuid [pk]
  order_id uuid [not null, ref: > orders.id, note: 'one payment per order']
  status varchar(20) [not null, default: 'pending', note: 'pending | paid | failed | refunded']
  amount decimal(12,2) [not null, note: '= order.total']
  currency varchar(8) [not null, default: 'RWF']
  method varchar(30) [default: 'airtel_money', note: 'airtel_money (first PSP)']
  provider_ref varchar(255) [note: 'gateway request_reference, e.g. MOMO-XXXXXXXXXXXX']
  momo_phone varchar(20) [note: 'buyer Airtel Money wallet to charge (nullable)']
  airtel_phone varchar(20) [note: 'Airtel line the payment is sent from (nullable)']
  paid_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// The single accounting record. Created EXACTLY ONCE, in the same DB
// transaction as Payment -> paid (unique order_id = idempotency, never
// double-credited). revenue_rate is the 7% (premium) / 12% (basic)
// snapshot resolved via premium.get_commission_rate at paid time.
Table revenue_transactions {
  id uuid [pk]
  order_id uuid [not null, unique, ref: > orders.id]
  payment_id uuid [not null, ref: > payments.id]
  seller_id uuid [not null, ref: > sellers.id]
  amount decimal(12,2) [not null, note: 'seller gross']
  revenue_rate decimal(5,2) [not null, note: '7% premium | 12% basic snapshot']
  commission_amount decimal(12,2) [not null, note: "MUHUZE's cut = amount * rate / 100"]
  seller_earning decimal(12,2) [not null, note: 'amount - commission_amount -> future wallet']
  currency varchar(8) [not null, default: 'RWF']
  referral_eligible boolean [not null, default: false, note: 'placeholder for future referrals (from premium plan flag)']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Auth: accounts & sessions ────────────────────────────────────────
Table accounts {
  id uuid [pk]
  email varchar(255) [not null, unique]
  phone varchar(20) [unique, note: 'nullable']
  password_hash varchar(255) [not null]
  is_active boolean [not null, default: true]
  is_verified boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table profiles {
  id uuid [pk]
  account_id uuid [not null, unique, ref: - accounts.id, note: '1:1 with accounts — personal info kept separate']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table refresh_tokens {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  token_hash varchar(64) [not null, unique, note: 'only the hash is stored']
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table verification_codes {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  purpose varchar(30) [not null, note: 'email_verification | phone_verification']
  code_hash varchar(64) [not null]
  expires_at timestamp [not null]
  verified_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table password_reset_tokens {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  token_hash varchar(64) [not null, unique]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

// ── Auth: roles & permissions ────────────────────────────────────────
Table roles {
  id uuid [pk]
  name varchar(50) [not null, unique, note: 'seeded: buyer | seller | admin']
  description varchar(255)
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table permissions {
  id uuid [pk]
  code varchar(100) [not null, unique, note: 'e.g. products.delete']
  name varchar(150) [not null]
  description varchar(255)
  resource varchar(50) [not null]
  action varchar(50) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table account_roles {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id, note: 'unique (account_id, role_id)']
  role_id uuid [not null, ref: > roles.id, note: 'CASCADE delete']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table role_permissions {
  id uuid [pk]
  role_id uuid [not null, ref: > roles.id, note: 'CASCADE delete; unique (role_id, permission_id)']
  permission_id uuid [not null, ref: > permissions.id, note: 'CASCADE delete']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table account_permissions {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id, note: 'GRANT only, no deny; unique (account_id, permission_id)']
  permission_id uuid [not null, ref: > permissions.id, note: 'CASCADE delete']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}
