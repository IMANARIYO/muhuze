# MUHUZE Global Link — backend environment configuration
#
# Copy this file to `.env` (same directory) and fill in real values.
# Case-insensitive keys, loaded at import time by app/core/config.py.
#
#       cp .env.example .env

# --- App -------------------------------------------------------------------
APP_NAME=MUHUZE Global Link
# environment: development | test | production
ENVIRONMENT=development

# --- Database (SQLAlchemy async URL) ----------------------------------------
# PostgreSQL (asyncpg):
#   postgresql+asyncpg://user:password@host:5432/dbname
# In-memory SQLite for local tests:
#   sqlite+aiosqlite:///:memory:
DATABASE_URL=

# --- Authentication (PyJWT) -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Bootstrap accounts (seeded at startup — see app/core/bootstrap.py) ------
# super_admin_* is seeded in every environment (an admin must exist
# somewhere). test_seller_* is skipped in production regardless.
# Leave empty to skip seeding that account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
TEST_SELLER_EMAIL=
TEST_SELLER_PASSWORD=

# --- File storage (Cloudinary) — app/core/storage.py -------------------------
# Optional: the app starts without these, but uploading will raise
# StorageNotConfiguredError until they're set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) — app/core/notifications.py --------------------------------
# Optional: unset means send_email logs instead of actually sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
