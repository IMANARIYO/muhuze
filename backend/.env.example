# MUHUZE Global Link — backend environment configuration
#
# Copy to `.env` in this directory and adjust:   cp .env.example .env
# Never commit `.env`. Never put real payment account details here — those
# are admin-managed data, not configuration.

# --- App -----------------------------------------------------------------
APP_NAME=MUHUZE Global Link
# development | test | staging | production
ENVIRONMENT=development

# --- Logging -------------------------------------------------------------
# Leave empty to derive from ENVIRONMENT:
#   level:  DEBUG in development, INFO elsewhere
#   format: text in development/test, json in staging/production
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=
# LOG_FORMAT: text | json
LOG_FORMAT=

# --- Database (PostgreSQL) ------------------------------------------------
# postgresql://user:password@host:5432/dbname   (run on asyncpg automatically)
# A hosted provider's URL can be pasted as-is: `?sslmode=require` and
# `channel_binding=require` are translated for the driver.
# Apply migrations with:  uv run alembic upgrade head
DATABASE_URL=
# Only for running the tests. A SEPARATE database whose name ends with "_test":
# the test run drops and rebuilds its schema every time.
TEST_DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# Required, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# HS256 | HS384 | HS512
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Frontend page that receives ?token=... from the password reset email.
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# --- Email (SMTP) -----------------------------------------------------------
# Leave SMTP_HOST empty in development: emails (verification codes, reset
# links) are written to the log instead of sent. Staging and production
# refuse to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME when empty.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
